{
  "expo": {
    "name": "moyeota",
    "slug": "moyeota",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/png/MoyeotaLogoPNG.png",
    "userInterfaceStyle": "light",
    // "sdkVersion": "51.0.11",
    "splash": {
      "image": "./assets/moyeotaSplash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moyeota.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.moyeota.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b183fb7b-d5d2-4deb-be36-2d67782390d7"
      }
    }
  }
}
